{
  "expo": {
    "name": "nutriselect-app",
    "slug": "nutriselect-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nutriselectapp",  
    "plugins": [
      "expo-barcode-scanner",
      "expo-web-browser"
    ],
    "platforms": [
      "ios",
      "android"
    ],
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Esta app necesita acceso a la cámara para escanear códigos de barras de alimentos."
      }
    },
    "android": {
      "permissions": [
        "CAMERA"
      ]
    }
  }
}
